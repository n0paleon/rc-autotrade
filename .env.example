# ── TURU.RC Worker ──────────────────────────────────────────────
# Copy this file to .env and edit as needed.

# HTTP/WebSocket control plane
HOST=127.0.0.1
PORT=8787

# Optional. If empty, a key is generated on first boot and printed once.
# Set this to pin your own key (min 16 chars recommended).
WORKER_TOKEN=

# Runtime state (tokens, configs, stats). Keep this directory private.
DATA_DIR=./data

# Rollercoin upstream endpoints
RC_API_BASE=https://rollercoin.com
RC_WS_URL=wss://nws.rollercoin.com/

# Optional Cloudflare cookie header copied from your browser.
# Example: cf_clearance=...; __cf_bm=...
RC_COOKIE=

# Simulated market for development. Do NOT use in production.
MOCK=0

# Log level: debug | info | warn | error
LOG_LEVEL=info
