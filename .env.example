# ── TURU.RC Worker ──────────────────────────────────────────────
# Copy this file to .env and edit as needed.

# HTTP/WebSocket control plane
HOST=127.0.0.1
PORT=8787

# Optional. If empty, a key is generated on first boot and printed once.
# Set this to pin your own key (min 16 chars recommended).
WORKER_TOKEN=

# Runtime state (SQLite database: tokens, configs, stats, market cache).
# Keep this directory private.
DATA_DIR=./data

# Rollercoin upstream endpoints
RC_API_BASE=https://rollercoin.com
RC_WS_URL=wss://nws.rollercoin.com/

# HTTP keep-alive pool. These defaults are used when the variable is empty/unset.
# RC_HTTP_KEEPALIVE_MS=60000
# RC_HTTP_CONNECTIONS=8

# Warm probe so the first purchase after a quiet period does not pay a TCP/TLS
# handshake. 0 disables it; any other value is clamped to 5000..600000 ms.
# RC_KEEPALIVE_MS=30000
# Default: ${RC_API_BASE}/api/events/config
# RC_KEEPALIVE_URL=

# Optional Cloudflare cookie header copied from your browser.
# Example: cf_clearance=...; __cf_bm=...
RC_COOKIE=

# Worker health sampler (CPU, memory, event loop, load). The SYSTEM tab reads
# these samples. Clamped to 500..60000 ms; the default is 2000 ms.
# SYSTEM_SAMPLE_MS=2000

# Simulated market for development. Do NOT use in production.
MOCK=0

# Log level: debug | info | warn | error
LOG_LEVEL=info
