{
  "name": "turu-rc-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Headless Rollercoin marketplace sniper with an 8-bit arcade control deck.",
  "type": "module",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "build": "bunx --bun vite build",
    "start": "bun run build && bun src/worker/index.js",
    "dev": "bun scripts/dev.js",
    "dev:ui": "node node_modules/vite/bin/vite.js",
    "dev:worker": "bun --watch src/worker/index.js",
    "mock": "bun run build && MOCK=1 bun src/worker/index.js",
    "diagnose:ws": "bun scripts/diagnose-ws.js",
    "pretest": "bun run build",
    "test": "bun test",
    "key:reset": "bun src/worker/reset-token.js",
    "pm2:start": "bun run build && pm2 startOrReload ecosystem.config.cjs --update-env"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5"
  }
}
