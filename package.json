{
  "name": "turu-rc-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Headless Rollercoin marketplace sniper with an 8-bit arcade control deck: Rust backend, React deck.",
  "type": "module",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "build": "bunx --bun vite build",
    "dev": "bun scripts/dev.mjs",
    "dev:ui": "node node_modules/vite/bin/vite.js",
    "start": "bun run build && cargo run --release",
    "mock": "bun run build && MOCK=1 cargo run --release",
    "test": "cargo test && bun test",
    "format": "cargo fmt",
    "lint": "cargo clippy --all-targets",
    "diagnose:ws": "cargo run --release --example diagnose_ws",
    "key:reset": "cargo run --release --bin reset_token",
    "bench:frame": "cargo run --release --example bench_frame",
    "bench:trend": "cargo run --release --example bench_trend",
    "pm2:start": "bun run build && cargo build --release && pm2 startOrReload ecosystem.config.cjs --update-env"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5"
  }
}
